# Local development only. Set your own database password and random session secret.
DATABASE_URL="postgresql://pbl517_app:CHANGE_ME@127.0.0.1:5432/pbl517"
SESSION_SECRET=""
PORT=3000
NODE_ENV=development
# 0 = no proxy trust locally; loopback = only a local Nginx proxy in production.
TRUST_PROXY=0

# OWASP Top 10 Lab Vulnerability Toggles (true = mở lỗi để demo; false = đã bịt lỗi/an toàn).
# Secure Baseline mặc định false; production/EC2 giữ false. Đọc qua process env nên
# systemd Environment=/EnvironmentFile và Docker -e đều có hiệu lực, không phụ thuộc file .env.
VULN_IDOR_ENABLED=false
