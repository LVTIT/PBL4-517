# External Scanner & Alert Configuration (Issue #10)
# Copy this file to .env and fill in your actual credentials

DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ChatOps is disabled until at least one numeric Telegram user ID is listed.
# Both the configured chat and sender must match, for commands and callbacks.
TELEGRAM_ALLOWED_USER_IDS=
# Remote ChatOps accepts only explicit authorized IPv4 addresses, no hostnames.
SCANNER_TARGET=127.0.0.1
SCANNER_ALLOWED_TARGETS=127.0.0.1
# Optional: share the scheduler's state path with ChatOps on the same VM.
# Local defaults below resolve from the repository, even from another directory.
# CLI and ChatOps share these paths. Process environment overrides this file.
# Ubuntu scheduler: use /var/lib/pbl517-monitor/scanner.state.json instead.
SCANNER_STATE_FILE=.local/runtime/scanner.state.json
PBL517_REPORTS_DIR=.local/reports/scanner

# Website credentials and OWASP flags: website/backend/.env (created by dev setup).
# Never put database credentials or session secrets in VITE_* variables.
